# データベース接続先（SQLite）
DATABASE_URL=file:./dev.db

# Google Maps の API キー
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Auth.js (NextAuth v5)
# セッション署名用シークレット。次のコマンドで生成すること: openssl rand -base64 32
AUTH_SECRET=

# Google Cloud Console で発行した OAuth クライアント認証情報を設定する。
# 承認済みリダイレクトURIに http://localhost:3000/api/auth/callback/google を登録すること。
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
