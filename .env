DATABASE_URL=file:./dev.db
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Auth.js (NextAuth v5)
# セッション署名用のシークレット（例: openssl rand -base64 32 で生成）
AUTH_SECRET="ZxUj5P8bQ2mN4vL7yK1wX9cD3fH6gJ0sT5rE8uI2oP4aS7dG1h"
# Google Cloud Consoleで発行したOAuthクライアントの認証情報を設定してください
# 承認済みのリダイレクトURIには http://localhost:3000/api/auth/callback/google を登録すること
AUTH_GOOGLE_ID=YOUR_GOOGLE_CLIENT_ID
AUTH_GOOGLE_SECRET=YOUR_GOOGLE_CLIENT_SECRET